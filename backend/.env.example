# Nama aplikasi — dipakai di judul Swagger dan log
APP_NAME=DAAK_BE
APP_ENV=local
PORT=3020
APP_URL=http://localhost:3020

# Database
TYPEORM_HOST=172.30.13.188
TYPEORM_PORT=5432
TYPEORM_USERNAME=daak_app
TYPEORM_PASSWORD=
TYPEORM_DATABASE=daak_portal
TYPEORM_SCHEMA=public

# JWT & captcha — WAJIB diisi, minimal 32 karakter: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1800
# Masa sesi bila pengguna mencentang "Ingat saya" (detik) — 7 hari
JWT_REMEMBER_EXPIRES_IN=604800

# Frontend (CORS). Boleh beberapa, pisahkan koma.
FRONTEND_URL=http://localhost:5174

# Log
LOG_PATH=logs

# true = biarkan TypeORM menyamakan skema. JANGAN di atas DB hasil migrasi berisi data.
TYPEORM_SYNC=false
